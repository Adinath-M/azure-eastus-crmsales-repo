{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "df_dumps_transactions",
						"type": "DatasetReference"
					},
					"name": "transactions"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "df_files_datacleaned",
						"type": "DatasetReference"
					},
					"name": "transactionsclean"
				}
			],
			"transformations": [
				{
					"name": "FixNonNumeric"
				}
			],
			"scriptLines": [
				"source(output(",
				"          TransactionID as string,",
				"          Date as string,",
				"          CustomerName as string,",
				"          Product as string,",
				"          Quantity as string,",
				"          Price as string,",
				"          Discount as string,",
				"          Region as string,",
				"          Salesperson as string,",
				"          PaymentStatus as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> transactions",
				"transactions derive(Quantity = iif(isInteger(Quantity),toInteger(Quantity),0),",
				"          CustomerName = iif(isNull(CustomerName), 'N/A',lower(trim(CustomerName))),",
				"          Region = upper(Region)) ~> FixNonNumeric",
				"FixNonNumeric sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> transactionsclean"
			]
		}
	}
}