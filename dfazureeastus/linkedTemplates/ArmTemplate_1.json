		{
			"name": "[concat(parameters('factoryName'), '/dataflow1')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "df_dumps_transactions",
								"type": "DatasetReference"
							},
							"name": "transactions"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "df_files_clean_Northdata",
								"type": "DatasetReference"
							},
							"name": "transactionsclean"
						}
					],
					"transformations": [
						{
							"name": "FixNonNumeric"
						},
						{
							"name": "split1"
						},
						{
							"name": "aggregate1"
						},
						{
							"name": "derivedColumn1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          TransactionID as string,",
						"          Date as string,",
						"          CustomerName as string,",
						"          Product as string,",
						"          Quantity as string,",
						"          Price as string,",
						"          Discount as string,",
						"          Region as string,",
						"          Salesperson as string,",
						"          PaymentStatus as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     inferDriftedColumnTypes: true,",
						"     ignoreNoFilesFound: false) ~> transactions",
						"transactions derive(Quantity = iif(isInteger(Quantity),toInteger(Quantity),0),",
						"          CustomerName = iif(isNull(CustomerName), 'N/A',lower(trim(CustomerName))),",
						"          Region = upper(Region),",
						"          Price = toInteger(Price)) ~> FixNonNumeric",
						"aggregate1 split(Region == 'NORTH',",
						"     Region == 'EAST',",
						"     disjoint: false) ~> split1@(North, EAST, Other)",
						"derivedColumn1 aggregate(groupBy(Region),",
						"     {Total Sales} = sum({Gross Sales})) ~> aggregate1",
						"FixNonNumeric derive({Gross Sales} = Quantity*Price) ~> derivedColumn1",
						"split1@North sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> transactionsclean"
					]
				}
			},
			"dependsOn": []
		},
